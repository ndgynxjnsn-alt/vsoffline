# Public https url of the offline marketplace. Must match the url configured in the OfflineMarketplace extension.
PUBLIC_URL=https://vscode-offline.company.org
# Also replaces update.code.visualstudio.com and marketplace.visualstudio.com hardcoded in the code of imported VSIX files.
# Those VSIX files lose their marketplace signature. Change the hosts with REWRITE_HOSTS (comma separated, empty disables).
