{
  "name": "offline-marketplace",
  "displayName": "OfflineMarketplace",
  "description": "Points VS Code at a self-hosted offline marketplace for extensions, updates and the remote server.",
  "version": "1.0.0",
  "publisher": "offline",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionKind": [
    "ui"
  ],
  "contributes": {
    "commands": [
      {
        "command": "offlineMarketplace.configure",
        "title": "Set Marketplace URL",
        "category": "Offline Marketplace"
      },
      {
        "command": "offlineMarketplace.check",
        "title": "Check Configuration",
        "category": "Offline Marketplace"
      },
      {
        "command": "offlineMarketplace.importCertificate",
        "title": "Import CA Certificate",
        "category": "Offline Marketplace"
      }
    ],
    "configuration": {
      "title": "Offline Marketplace",
      "properties": {
        "offlineMarketplace.url": {
          "type": "string",
          "default": "",
          "scope": "application",
          "markdownDescription": "Base URL of the offline marketplace, e.g. `https://vscode-marketplace.internal`. VS Code's product.json is patched to use it for extensions and updates."
        },
        "offlineMarketplace.checkOnStartup": {
          "type": "boolean",
          "default": true,
          "scope": "application",
          "description": "Check product.json, server reachability and the Dev Containers server cache on startup."
        },
        "offlineMarketplace.serverCachePlatforms": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "linux-x64",
              "linux-arm64",
              "linux-alpine"
            ]
          },
          "default": [
            "linux-x64"
          ],
          "scope": "application",
          "description": "VS Code server builds to place into the Dev Containers download cache, so containers can be opened without reaching the official update server."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "package": "tsc -p . && vsce package --no-dependencies --skip-license --allow-missing-repository -o offline-marketplace.vsix"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/vscode": "~1.90.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "~5.6.3"
  }
}
